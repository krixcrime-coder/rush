<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-to-top dark gradient behind the category name label, so the
     white text stays readable regardless of how bright the thumbnail
     image underneath is. Replaces the flat semi-transparent strip that
     could disappear against dark thumbnails. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#F2000000"
        android:centerColor="#B0000000"
        android:endColor="#00000000" />
</shape>
