<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="30dp">

    <ImageView
        android:id="@+id/fail_icon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/fail_icon" />

    <TextView
        android:id="@+id/fail_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Transaction Failed"
        android:textColor="@color/newred"
        android:textStyle="bold"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/fail_reason_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Something went wrong with your transaction."
        android:textColor="@color/cb_dark_grey"
        android:textSize="14sp" />

    <Button
        android:id="@+id/fail_retry_button"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="35dp"
        android:background="@drawable/button_bg"
        android:text="@string/try_again"
        android:textColor="@color/white"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/fail_home_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/go_to_home"
        android:textColor="@color/purple"
        android:textStyle="bold" />
</LinearLayout>
